###########################################################################################
# MMI-Cockpit-Carplay - CarPlay private111 Direct Display V2
###########################################################################################
screen "MMI-Cockpit-Carplay" Customization

keyValue
    value   String sys 0x00000000 0
    label   "Direct flow: type111 -> stock OMX -> decoded SHM -> GLES displayable3 -> Java Context80"
    poll    0

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/install_mmi_cockpit_carplay_rx.sh"
   label   "INSTALL"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/start_mmi_cockpit_carplay_rx_test.sh"
   label   "START"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/status_mmi_cockpit_carplay_test.sh"
   label   "STATUS"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/finish_mmi_cockpit_carplay_test.sh"
   label   "STORE LOGS + RESTORE"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/stop_mmi_cockpit_carplay_test.sh"
   label   "RESTORE ORIGINAL"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/force_start_mmi_cockpit_carplay_rx_test.sh"
   label   "START (alias)"
script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cluster_layout_default.sh"
   label   "Cluster map layout: AltScreen default"
script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cluster_layout_top.sh"
   label   "Cluster map layout: maneuver card on top"
script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cluster_layout_right.sh"
   label   "Cluster map layout: maneuver card on the right"
script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cluster_layout_noeta.sh"
   label   "Cluster map layout: no ETA"
script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cluster_shift_off.sh"
   label   "Cluster map shift: off"
script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cluster_shift_left120.sh"
   label   "Cluster map shift: left 120 px (Amap/Baidu)"
script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cluster_shift_left240.sh"
   label   "Cluster map shift: left 240 px (Amap/Baidu)"
script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cluster_shift_sporttest.sh"
   label   "Cluster map shift: Sport test (small view -476 px)"
script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/dump_cluster_h264.sh"
   label   "Dump cluster video to SD (diagnostic)"
